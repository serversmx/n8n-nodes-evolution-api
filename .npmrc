# @n8n/eslint-plugin-community-nodes declares an exact peerDependency on eslint 9.29.0, while the
# rest of this project runs on eslint ^8.57.0 (npm run lint's .eslintrc.js legacy config). We run
# the community-nodes plugin's rules through eslint 8.57's flat-config support instead of a
# second eslint major version (see eslint.n8n.config.mjs), so that peer constraint doesn't apply
# to how it's actually used here. Without this, `npm ci` (used by CI and the publish workflow)
# fails with ERESOLVE on that unmet peer dependency.
legacy-peer-deps=true
